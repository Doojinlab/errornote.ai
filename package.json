{
  "name": "errornote",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "db:types": "supabase gen types typescript --local > types/database.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "icons:build": "powershell -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "sounds:gen": "powershell -ExecutionPolicy Bypass -File scripts/generate-sounds.ps1",
    "sounds:build": "node scripts/build-sounds.mjs",
    "loadtest:live": "tsx scripts/live-loadtest.ts",
    "pwa:check": "node scripts/check-pwa-manifest.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.105.1",
    "cheerio": "^1.2.0",
    "howler": "^2.2.4",
    "mammoth": "^1.8.0",
    "next": "16.2.9",
    "next-intl": "^4.11.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "glob": "^10.5.0",
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/howler": "^2.2.12",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  }
}
