# ─────────────────────────────────────────────────────────────────────────────
# errornote.ai — 환경 변수 예시
# 이 파일을 .env.local 로 복사한 뒤 실제 값으로 교체하세요.
# .env.local 은 절대 Git 에 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# 대시보드: https://app.supabase.com → Settings → API
# NEXT_PUBLIC_ 접두사 변수는 브라우저에도 노출됩니다 (RLS 가 적용되므로 안전).
# SERVICE_ROLE_KEY 는 서버 전용 — 브라우저에 절대 노출하지 마세요.

NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ── Anthropic Claude API ──────────────────────────────────────────────────────
# 대시보드: https://console.anthropic.com → API Keys
# lib/claude.ts 의 completeJSON / streamText 에서 사용합니다.

ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# ── Resend (이메일) ───────────────────────────────────────────────────────────
# 대시보드: https://resend.com → API Keys
# 카드뉴스 이메일 발송(lib/email.ts)에 사용합니다.

RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
# 미설정 시 기본값: errornote <noreply@errornote.ai>
RESEND_FROM_EMAIL=errornote <noreply@errornote.ai>

# ── 카카오 알림 (OAuth 나에게 보내기) ─────────────────────────────────────────
# 대시보드: https://developers.kakao.com → 내 애플리케이션 → 앱 키
# 카카오 REST API 키(Client ID)와 Client Secret 을 입력하세요.
# 리다이렉트 URI 는 카카오 앱 설정 → 플랫폼 → Web 에도 동일하게 등록해야 합니다.

KAKAO_CLIENT_ID=YOUR_KAKAO_REST_API_KEY_HERE
KAKAO_CLIENT_SECRET=YOUR_KAKAO_CLIENT_SECRET_HERE
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/api/notifications/kakao/connect

# Kakao 토큰 대칭 암호화 키 (pgcrypto pgp_sym_encrypt).
# 16자 이상 권장 (예: openssl rand -base64 32). 서버 전용. 절대 노출 금지.
# 이 값이 바뀌면 모든 사용자가 카카오 재연동 필요 — 일종의 "마스터 키".
KAKAO_TOKEN_ENCRYPTION_KEY=YOUR_KAKAO_TOKEN_ENCRYPTION_KEY_HERE

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# 키 생성: npx web-push generate-vapid-keys
# NEXT_PUBLIC_ 공개키는 ServiceWorker 구독 시 브라우저에서 사용합니다.
# VAPID_PRIVATE_KEY 는 서버에서 알림 서명 시 사용 — 절대 노출하지 마세요.

NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE
# 발신자 식별용 (RFC 형식: mailto:... 또는 https://...)
WEB_PUSH_SUBJECT=mailto:noreply@errornote.ai

# ── 번역 API (역방향 번역 비교 기능) ─────────────────────────────────────────
# 세 엔진(DeepL · Papago · OpenAI)이 병렬로 번역 결과를 생성합니다.
# 미사용 엔진은 빈 값으로 두면 해당 번역 결과가 생략됩니다.

# DeepL: https://www.deepl.com/pro-api
DEEPL_API_KEY=YOUR_DEEPL_API_KEY_HERE

# Papago (네이버 클라우드): https://api.ncloud-docs.com/docs/ai-naver-papagonmt
PAPAGO_CLIENT_ID=YOUR_PAPAGO_CLIENT_ID_HERE
PAPAGO_CLIENT_SECRET=YOUR_PAPAGO_CLIENT_SECRET_HERE

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# 번역에 사용할 모델 (기본값: gpt-4o-mini)
OPENAI_TRANSLATE_MODEL=gpt-4o-mini

# ── 앱 공통 ───────────────────────────────────────────────────────────────────

# 앱의 공개 URL — 카드뉴스 이메일 링크, 카카오 리다이렉트 URI 기본값에 사용됩니다.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 정적 미디어(영상 등) CDN 베이스 URL — 설정 시 hero.mp4/feature.mp4 등을 이 베이스에서
# 로드합니다(예: https://cdn.errornote.ai 또는 Vercel Blob 도메인). 미설정 시 로컬 /public 사용.
# 대용량 영상을 리포에서 분리해 CDN 으로 서빙할 때 사용합니다. (lib/asset-url.ts)
# NEXT_PUBLIC_ASSET_BASE_URL=

# Cron 작업 인증 시크릿 — Vercel Cron 등 외부 스케줄러가 외부 API 를 호출할 때 검증합니다.
# 임의의 긴 문자열로 설정하세요 (예: openssl rand -hex 32).
CRON_SECRET=YOUR_CRON_SECRET_HERE

# 주간 리포트 cron 의 학생 처리 동시성 (기본 5, 범위 1~20).
# 높이면 벽시계는 줄지만 Claude rate limit 압박이 커진다. 저티어면 3~5 권장.
WEEKLY_REPORT_CONCURRENCY=5

# ── 운영 모니터링 (#50) ───────────────────────────────────────────────────────
# Sentry: @sentry/nextjs 는 이제 기본 의존성으로 설치돼 있습니다(#130).
#   활성화: 아래 DSN 만 설정하면 lib/monitoring.ts / instrumentation*.ts /
#   app/global-error.tsx 가 자동으로 Sentry 로 전송합니다(별도 설치 불필요).
#   미설정이면 에러/경보는 구조적 JSON 로그로만 남습니다(빌드 영향 없음).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Claude API 토큰/비용 상세 로그(tag=claude_usage). 1 이면 호출별 토큰·캐시·비용 출력.
# (비용/토큰 메트릭 tag=metric 은 이 값과 무관하게 항상 기록됩니다.)
ANTHROPIC_LOG_USAGE=0

# Supabase Realtime 동시연결 한도 추정치 — /api/live/realtime-quota 경보 임계 산정용.
# 플랜에 맞게 설정(free≈200, pro≈500). 미설정 시 200.
SUPABASE_REALTIME_CONCURRENT_LIMIT=200

# Vercel Web Analytics / Speed Insights 는 @vercel/analytics, @vercel/speed-insights
# 패키지로 자동 동작합니다(Vercel 배포 시). 별도 키 불필요.

# ── LTI 1.3 (Canvas/Moodle 표준 연동, #47) ───────────────────────────────────
# 런치 검증(id_token 서명)에는 jose 패키지가 필요합니다: npm install jose
# 플랫폼(LMS) 등록은 lti_platforms 테이블에 저장합니다(issuer/client_id/deployment + 엔드포인트).
#
# 도구(Tool) 공개키 JWKS — 플랫폼이 도구 서명(Deep Linking/AGS 응답)을 검증할 때 사용.
# 단일 공개 JWK 를 JSON 한 줄로 넣으면 /api/lti/jwks 가 노출합니다(런치 검증만이면 불필요).
LTI_TOOL_PUBLIC_JWK=
# 도구 서명용 개인키(PEM, PKCS#8) — Deep Linking 응답/AGS client assertion 서명에 사용. 서버 전용.
# Deep Linking 응답 서명을 켜려면: npm install jose + 이 키 + LTI_TOOL_KID 설정.
LTI_TOOL_PRIVATE_KEY=
LTI_TOOL_KID=errornote-lti-1
# Deep Linking 핸드오프 토큰(launch→선택→응답) HMAC 비밀키. 미설정 시 SUPABASE_SERVICE_ROLE_KEY 로 폴백.
LTI_DL_SECRET=

# ── E2E (Playwright) ─────────────────────────────────────────────────────────
# RLS 정책 검증용 — e2e/rls.spec.ts 에서만 사용. 로컬 dev / staging 전용.
# 미설정 시 RLS 테스트는 스킵된다. 운영 DB 에서는 절대 실행하지 말 것.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=

# ── ElevenLabs TTS (실전 HSK 듣기 음성) ───────────────────────────────────────
# 대시보드: https://elevenlabs.io → Profile → API Keys
# 없으면 HSK 듣기(/hsk/session, 영역=듣기) 음성 재생이 비활성되고 대본 표시로 폴백합니다.
# app/api/tts 에서 사용(듣기 지문·热词 발음 공통). VOICE_ID/MODEL_ID 는 선택(미설정 시 기본 보이스·eleven_v3).
ELEVENLABS_API_KEY=
# 보이스 재정의(선택). 기본: 21m00Tcm4TlvDq8ikWAM (멀티링구얼 모델에서 중국어 지원)
ELEVENLABS_VOICE_ID=
# 모델 재정의(선택). 기본: eleven_v3 (고품질). 계정에서 v3 미지원 시 eleven_multilingual_v2 등으로 지정.
ELEVENLABS_MODEL_ID=
